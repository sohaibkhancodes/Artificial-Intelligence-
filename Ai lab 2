        "\n",
        "# ============================================================\n",
        "# VACUUM WORLD (used for Tasks 3 and 4)\n",
        "# Score = +1 per clean square per time step\n",
        "# Move penalty (Task 4) = -1 per Left/Right action\n",
        "# ============================================================\n",
        "class VacuumWorld:\n",
        "    \"\"\"Two-square vacuum world. loc in {'A','B'}.\"\"\"\n",
        "    def __init__(self, loc, a_status, b_status):\n",
        "        self.loc = loc\n",
        "        self.status = {\"A\": a_status, \"B\": b_status}\n",
        "\n",
        "    def percept(self):\n",
        "        return (self.loc, self.status[self.loc])\n",
        "\n",
        "    def step(self, action):\n",
        "        moved = False\n",
        "        if action == \"Suck\":\n",
        "            self.status[self.loc] = \"Clean\"\n",
        "        elif action == \"Left\":\n",
        "            self.loc = \"A\"; moved = True\n",
        "        elif action == \"Right\":\n",
        "            self.loc = \"B\"; moved = True\n",
        "        # NoOp: nothing happens\n",
        "        clean_squares = sum(1 for s in self.status.values() if s == \"Clean\")\n",
        "        return clean_squares, moved\n",
        "\n",
        "# ---------------- Agent programs ----------------\n",
        "def reflex_agent(percept):\n",
        "    \"\"\"Simple reflex agent.\"\"\"\n",
        "    location, status = percept\n",
        "    if status == \"Dirty\":\n",
        "        return \"Suck\"\n",
        "    return \"Right\" if location == \"A\" else \"Left\"\n",
        "\n",
        "def random_agent(percept):\n",
        "    \"\"\"Task 3: random action from {Left, Right, Suck}.\"\"\"\n",
        "    return random.choice([\"Left\", \"Right\", \"Suck\"])\n",
        "\n",
        "class ModelBasedAgent:\n",
        "    \"\"\"Task 4: remembers cleaned squares; NoOp when both are clean.\"\"\"\n",
        "    def __init__(self):\n",
        "        self.known_clean = set()          # internal model / memory\n",
        "\n",
        "    def __call__(self, percept):\n",
        "        location, status = percept\n",
        "        if status == \"Clean\":\n",
        "            self.known_clean.add(location)\n",
        "        else:\n",
        "            self.known_clean.discard(location)\n",
        "\n",
        "        if status == \"Dirty\":\n",
        "            return \"Suck\"\n",
        "        if self.known_clean == {\"A\", \"B\"}:\n",
        "            return \"NoOp\"\n",
        "        return \"Right\" if location == \"A\" else \"Left\"\n",
        "\n",
        "# ---------------- Simulation helpers ----------------\n",
        "def run_episode(agent, init_state, steps=20, move_penalty=0):\n",
        "    world = VacuumWorld(*init_state)\n",
        "    score = 0\n",
        "    for _ in range(steps):\n",
        "        action = agent(world.percept())\n",
        "        clean_squares, moved = world.step(action)\n",
        "        score += clean_squares\n",
        "        if moved:\n",
        "            score -= move_penalty\n",
        "    return score\n",
        "\n",
        "def make_agent(kind):\n",
        "    return {\"reflex\": lambda: reflex_agent,\n",
        "            \"random\": lambda: random_agent,\n",
        "            \"model\":  lambda: ModelBasedAgent()}[kind]()\n",
        "\n",
        "def evaluate(kind, initial_states, steps=20, move_penalty=0, seed=0):\n",
        "    random.seed(seed)\n",
        "    return [run_episode(make_agent(kind), s, steps, move_penalty) for s in initial_states]\n",
        "\n",
        "def avg_random(initial_states, steps=20, move_penalty=0, runs=100):\n",
        "    \"\"\"Random agent: average of many runs per state so luck does not decide the result.\"\"\"\n",
        "    return [np.mean([evaluate(\"random\", [s], steps, move_penalty, seed=k)[0] for k in range(runs)])\n",
        "            for s in initial_states]\n",
        "\n",
        "# ---------------- 10 random initial states ----------------\n",
        "random.seed(42)\n",
        "initial_states = [(random.choice([\"A\", \"B\"]),\n",
        "                   random.choice([\"Clean\", \"Dirty\"]),\n",
        "                   random.choice([\"Clean\", \"Dirty\"])) for _ in range(10)]\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"10 RANDOM INITIAL STATES (location, A, B)\")\n",
        "print(\"=\" * 60)\n",
        "for i, s in enumerate(initial_states, 1):\n",
        "    print(f\"  {i:2d}. {s}\")\n",
        "\n",
        "# ============================================================\n",
        "# TASK 3: RANDOM AGENT vs REFLEX AGENT (20 steps, 10 states)\n",
        "# ============================================================\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"TASK 3: RANDOM AGENT vs REFLEX AGENT\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "reflex_scores = evaluate(\"reflex\", initial_states, steps=20)\n",
        "random_scores = avg_random(initial_states, steps=20)\n",
        "\n",
        "t3 = pd.DataFrame({\n",
