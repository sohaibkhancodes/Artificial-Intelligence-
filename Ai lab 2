        "print(f\"Average score - Random agent : {np.mean(random_scores):.2f}\")\n",
        "print(\"Maximum possible in 20 steps : 40\")\n",
        "print(\"Conclusion: the reflex agent scores higher because it always cleans a dirty square\")\n",
        "print(\"and then moves to the other square; the random agent wastes steps.\")\n",
        "\n",
        "plt.figure(figsize=(5, 3.5))\n",
        "plt.bar([\"Reflex\", \"Random\"], [np.mean(reflex_scores), np.mean(random_scores)],\n",
        "        color=[\"tab:blue\", \"tab:orange\"])\n",
        "plt.ylabel(\"Average performance score\")\n",
        "plt.title(\"Task 3: Reflex vs Random (20 steps)\")\n",
        "plt.ylim(0, 40)\n",
        "plt.show()\n",
        "\n",
        "# ============================================================\n",
